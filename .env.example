# Edward Configuration Template
# Copy this file to .env and adjust values as needed.

# -----------------------------------------------------------------------------
# Storage & Database Paths
# -----------------------------------------------------------------------------
# Root data directory (defaults to platform app data directory if unset)
# EDWARD_DATA_DIR=~/.local/share/edward

# Canonical SQLite database path (defaults to <data-dir>/edward.sqlite3)
# EDWARD_DB_PATH=~/.local/share/edward/edward.sqlite3

# -----------------------------------------------------------------------------
# Answer Engine -- OFF BY DEFAULT
# -----------------------------------------------------------------------------
# Edward is memory, not a mind. Nothing is sent to a model unless you opt in here,
# and absent EDWARD_ANSWERER_MODE a leftover endpoint or model name is ignored.
#
# Leave everything below commented for the intended posture: `ask` returns
# deterministic and lookup answers, and `project outline` uses offline outlining or
# a proposal supplied by a calling agent via --input.
#
# To opt in, set EDWARD_ANSWERER_MODE plus an endpoint and model:
#   EDWARD_ANSWERER_MODE=local-model   # local-model | local | hosted | disabled
#   EDWARD_ANSWER_BASE_URL=http://localhost:11434/v1
#   EDWARD_ANSWER_MODEL=llama3.2
#   EDWARD_ANSWER_LOCATION=local       # local | hosted
#
# Note: --no-model still forces a deterministic answer regardless of this setting.
# EDWARD_ANSWERER_MODE=disabled
# EDWARD_ANSWER_BASE_URL=http://localhost:11434/v1
# EDWARD_ANSWER_MODEL=llama3.2
# EDWARD_ANSWER_LOCATION=local
# Maximum seconds for each answer-model request (research may make several requests)
# EDWARD_ANSWER_TIMEOUT=120

# -----------------------------------------------------------------------------
# Embeddings use the built-in local FastEmbed model by default.
# Set this only to select another model supported by FastEmbed.
# EDWARD_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Classifier (Jev / TypeSafe / OpenRouter)
# -----------------------------------------------------------------------------
EDWARD_CLASSIFIER_PROVIDER=disabled  # typesafe | openrouter | local | dry-run | disabled
EDWARD_CLASSIFIER_MODEL=~typesafe/jev-latest
EDWARD_CLASSIFIER_BASE_URL=https://openrouter.ai/api

# Provider Credentials (leave blank if disabled)
# TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Privacy & Outbound Data Transmission Policies
# -----------------------------------------------------------------------------
# Controls whether private content classes may be transmitted to hosted providers
EDWARD_HOSTED_GMAIL=deny
EDWARD_HOSTED_PERSONAL_NOTES=deny
EDWARD_HOSTED_DOCUMENTS=deny
EDWARD_HOSTED_PUBLIC_WEB=allow
